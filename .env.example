# Copy to .env (gitignored). Spring imports .env from the backend working directory.
FUSIONPBX_API_URL=https://10.155.199.136/app/rest_api/rest.php
FUSIONPBX_DOMAIN_NAME=10.155.199.136
FUSIONPBX_SERVER_IP=10.155.199.136
FUSIONPBX_WSS_URL=wss://10.155.199.136:7443
# Paste the complete key_uuid:token_secret string, not base64 and not a bearer token.
FUSIONPBX_API_TOKEN=
# Base64 of exactly 32 random bytes. Keep stable to decrypt saved SIP passwords.
FUSIONPBX_CREDENTIALS_KEY=
FUSIONPBX_EXTENSION_START=1000
FUSIONPBX_EXTENSION_END=9999
FUSIONPBX_CONNECT_TIMEOUT=2s
FUSIONPBX_REQUEST_TIMEOUT=5s
# Set false only for a trusted development PBX with a self-signed certificate.
FUSIONPBX_VERIFY_SSL=true

# Enable after existing users have their phone numbers and FreeSWITCH is configured.
PHONE_CALLS_ENABLED=true
